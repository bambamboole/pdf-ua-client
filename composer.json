{
    "name": "bambamboole/pdf-ua-client",
    "description": "Laravel client for rendering accessible PDF/UA documents with pdf-ua-api.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pdf",
        "pdf-ua",
        "accessibility",
        "laravel"
    ],
    "support": {
        "issues": "https://github.com/bambamboole/pdf-ua-client/issues",
        "source": "https://github.com/bambamboole/pdf-ua-client"
    },
    "authors": [
        {
            "name": "Manuel Christlieb",
            "email": "manuel@christlieb.eu"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.93 || ^2.0"
    },
    "require-dev": {
        "bambamboole/extended-testbench": "^0.6.1",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Bambamboole\\PdfUaClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bambamboole\\PdfUaClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "pint --test",
            "phpstan analyse",
            "rector --dry-run",
            "@test"
        ],
        "lint": "pint --format agent",
        "stan": "phpstan analyse",
        "refactor": "rector",
        "test": "pest",
        "test:coverage": "pest --coverage",
        "fix": [
            "@refactor",
            "@lint"
        ],
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "post-install-cmd": [
            "@boost:refresh"
        ],
        "post-update-cmd": [
            "@boost:refresh"
        ],
        "boost:refresh": "[ -n \"$CI\" ] || [ ! -f vendor/bin/testbench ] || [ ! -f boost.json ] || vendor/bin/testbench boost:update --no-interaction || true"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bambamboole\\PdfUaClient\\PdfUaClientServiceProvider"
            ]
        },
        "extended-testbench": {
            "check-ignore": [
                "phpstan.neon.dist",
                "rector.php",
                "composer script: boost:refresh"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
